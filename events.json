/* ===== Global Styles ===== */
body {
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  background-color: #f8f9fa;
  margin: 0;
  padding: 0;
}

/* ===== Header & Navbar ===== */
header {
  background-color: #212529;
}

.navbar-brand {
  font-size: 1.5rem;
  font-weight: bold;
  letter-spacing: 1px;
}

/* ===== Carousel ===== */
.carousel img {
  height: 400px;
  object-fit: cover;
  border-radius: 8px;
}

/* ===== Event Cards ===== */
.card {
  border: none;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.2);
}

.card-img-top {
  height: 200px;
  object-fit: cover;
}

.card-title {
  font-weight: 600;
  color: #0d6efd;
}

.card-text {
  color: #555;
  font-size: 0.95rem;
}

/* ===== Registration Form ===== */
section h3 {
  margin-bottom: 15px;
  font-weight: 600;
  color: #212529;
}

form {
  max-width: 500px;
}

.form-control {
  border-radius: 8px;
}

button.btn {
  border-radius: 25px;
  padding: 8px 25px;
  font-weight: 500;
}

/* ===== Footer ===== */
footer {
  font-size: 0.9rem;
  background-color: #212529;
}

/* ===== Responsive Adjustments ===== */
@media (max-width: 768px) {
  .carousel img {
    height: 250px;
  }

  .card-img-top {
    height: 160px;
  }
}
