<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
</head>
<body>

<% if (user) { %>
  <h1>Welcome <%= user.username %></h1>
  <p>Role: <%= user.role %></p>
  <a href="/logout">Logout</a>
<% } else { %>
  <h2>Please login first</h2>
  <a href="/login">Go to Login</a>
<% } %>

</body>
</html>
